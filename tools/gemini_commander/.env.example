# Gemini Commander Configuration
# Copy this to .env and fill in your values

# Required: Google AI Studio API key
# Get one at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here

# Optional: Override model selection
# GEMINI_MODEL_COMMANDER=gemini-2.5-flash
# GEMINI_MODEL_DEBUGGER=gemini-3.1-flash-lite

# Optional: Override master account email
# PY4GW_MASTER_EMAIL=your_master_email@example.com
